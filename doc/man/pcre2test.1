.TP 24
\f(CRno_jit\fP
.ad l
set \fBPCRE2_NO_JIT\fP
.TP 24
\f(CRno_utf_check\fP
.ad l
set \fBPCRE2_NO_UTF_CHECK\fP
.TP 24
\f(CRnotbol\fP
